{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-admin-test/types/**/*.ts",
    ".next-auth-test/types/**/*.ts",
    ".next-instructor-test/types/**/*.ts",
    ".next-master-test/types/**/*.ts",
    ".next-mission09-test/types/**/*.ts",
    ".next-mission091-final/types/**/*.ts",
    ".next-mission091-review/types/**/*.ts",
    ".next-mission092-definitive/types/**/*.ts",
    ".next-mission092-final/types/**/*.ts",
    ".next-mission092-release/types/**/*.ts",
    ".next-mission092-review/types/**/*.ts",
    ".next-mission092-validation/types/**/*.ts",
    ".next-mission10-audit-real/types/**/*.ts",
    ".next-mission10-audit-retry/types/**/*.ts",
    ".next-mission11-audit/types/**/*.ts",
    ".next-mission111-test/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
