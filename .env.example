# Public project URL and anonymous/publishable key from Supabase.
# Never expose a service_role key in this file or in browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep remote Auth disabled until the existing NAC project is audited, backed up,
# and its HTTPS callback URLs are approved.
NEXT_PUBLIC_NAC_ENABLE_REMOTE_AUTH=false
